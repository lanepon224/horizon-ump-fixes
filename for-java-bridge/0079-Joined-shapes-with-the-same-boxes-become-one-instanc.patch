From 459c80b512f45967b4f13ada1e7ed30395a3ff65 Mon Sep 17 00:00:00 2001
From: UMP <ump@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH 79/90] Joined shapes with the same boxes become one instance

Shapes.join's result is replaced by the instance made before with the same boxes (its AABB list, up to 64 boxes): wall and fence shapes and mods' collision shapes are joined from new parts for every state, so the identity memos of joinIsNotEmpty and join kept seeing new objects (first-time joins were 21% of the Java start: SupportType.isSupporting, Block.isShapeFullBlock, WallBlock.makeShapes, Yuushya's CollisionFileReader). Equal geometry is an equal shape; VoxelShape's only mutable field is its lazily filled face cache.

UMP 184 mods: 66.8k joined shapes shared (23.5k distinct); joinIsNotEmpty answered 11.60M of 11.67M; main entrypoints median 17.6 -> 15.2 s; ready median 68 s, join 37 s.
---
 .../horizonlab/platform/HorizonShapeMemo.java | 35 ++++++++++++++++++-
 .../platform/mixin/ShapesJoinMixin.java       |  9 +++--
 2 files changed, 41 insertions(+), 3 deletions(-)

diff --git a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonShapeMemo.java b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonShapeMemo.java
index 3471d01a53..940fa4f8dd 100644
--- a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonShapeMemo.java
+++ b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonShapeMemo.java
@@ -23,6 +23,26 @@ public final class HorizonShapeMemo {
     private record Box(double x0, double y0, double z0, double x1, double y1, double z1) {}
     private static final ConcurrentHashMap<Box, VoxelShape> BOXES = new ConcurrentHashMap<>();
     private static final LongAdder BOX_HITS = new LongAdder();
+    /** Joined shapes by their boxes (min x, y, z, max x, y, z each, in order): one instance per geometry. */
+    private static final ConcurrentHashMap<ShapeKey, VoxelShape> CANONICAL = new ConcurrentHashMap<>();
+    private static final LongAdder CANONICAL_HITS = new LongAdder();
+
+    private record ShapeKey(double[] boxes, int hash) {
+        static ShapeKey of(VoxelShape shape) {
+            java.util.List<net.minecraft.world.phys.AABB> list = shape.toAabbs();
+            double[] boxes = new double[list.size() * 6];
+            int i = 0;
+            for (net.minecraft.world.phys.AABB b : list) {
+                boxes[i++] = b.minX; boxes[i++] = b.minY; boxes[i++] = b.minZ;
+                boxes[i++] = b.maxX; boxes[i++] = b.maxY; boxes[i++] = b.maxZ;
+            }
+            return new ShapeKey(boxes, java.util.Arrays.hashCode(boxes));
+        }
+        @Override public boolean equals(Object o) {
+            return o instanceof ShapeKey k && k.hash == hash && java.util.Arrays.equals(k.boxes, boxes);
+        }
+        @Override public int hashCode() { return hash; }
+    }
     private static final LongAdder JOIN_HITS = new LongAdder();
     private static final LongAdder JOIN_MISSES = new LongAdder();
     private static final LongAdder HITS = new LongAdder();
@@ -81,6 +101,18 @@ public final class HorizonShapeMemo {
         BOXES.putIfAbsent(new Box(x0, y0, z0, x1, y1, z1), value);
     }
 
+    /** The instance made before with the same boxes as `shape` (an optimized join's), else `shape` itself. */
+    public static VoxelShape canonical(VoxelShape shape) {
+        if (!ON || shape == null || shape.isEmpty()) return shape;
+        ShapeKey key = ShapeKey.of(shape);
+        if (key.boxes.length > 6 * 64) return shape;
+        if (CANONICAL.size() >= MAX / 8) CANONICAL.clear();
+        VoxelShape known = CANONICAL.putIfAbsent(key, shape);
+        if (known == null) return shape;
+        CANONICAL_HITS.increment();
+        return known;
+    }
+
     /** One line: how often the memory answered (called after the mods' entrypoints). */
     public static void report() {
         long hits = HITS.sum(), misses = MISSES.sum();
@@ -88,7 +120,8 @@ public final class HorizonShapeMemo {
             Natives.log("Java mods: shape joins remembered " + hits + " of " + (hits + misses)
                     + " times; " + MEMO.size() + " kept; joined shapes " + JOIN_HITS.sum() + " of "
                     + (JOIN_HITS.sum() + JOIN_MISSES.sum()) + "; " + JOINS.size() + " kept; boxes shared " + BOX_HITS.sum()
-                    + " times, " + BOXES.size() + " kept");
+                    + " times, " + BOXES.size() + " kept; equal joined shapes shared " + CANONICAL_HITS.sum()
+                    + " times, " + CANONICAL.size() + " kept");
         }
     }
 }
diff --git a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/mixin/ShapesJoinMixin.java b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/mixin/ShapesJoinMixin.java
index 5317dc8728..9e70427a18 100644
--- a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/mixin/ShapesJoinMixin.java
+++ b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/mixin/ShapesJoinMixin.java
@@ -34,9 +34,14 @@ public abstract class ShapesJoinMixin {
     }
 
     @Inject(method = "join(Lnet/minecraft/world/phys/shapes/VoxelShape;Lnet/minecraft/world/phys/shapes/VoxelShape;Lnet/minecraft/world/phys/shapes/BooleanOp;)Lnet/minecraft/world/phys/shapes/VoxelShape;",
-            at = @At("RETURN"))
+            at = @At("RETURN"), cancellable = true)
     private static void horizon$rememberJoin(VoxelShape first, VoxelShape second, BooleanOp op, CallbackInfoReturnable<VoxelShape> info) {
-        HorizonShapeMemo.putJoin(first, second, op, info.getReturnValue());
+        // The shape made before with the same boxes, if any: shapes joined from new parts each time
+        // (wall and fence shapes, Yuushya's collision files) are then one instance, which the
+        // identity memos above answer for next time.
+        VoxelShape shape = HorizonShapeMemo.canonical(info.getReturnValue());
+        if (shape != info.getReturnValue()) info.setReturnValue(shape);
+        HorizonShapeMemo.putJoin(first, second, op, shape);
     }
 
     /**
