diff --git a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonShapeMemo.java b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonShapeMemo.java
new file mode 100644
index 0000000000..deb7527e74
--- /dev/null
+++ b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonShapeMemo.java
@@ -0,0 +1,59 @@
+package dev.horizonlab.platform;
+
+import dev.horizonlab.bridge.Natives;
+import net.minecraft.world.phys.shapes.BooleanOp;
+import net.minecraft.world.phys.shapes.VoxelShape;
+
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.LongAdder;
+
+/**
+ * Remembered answers of Shapes.joinIsNotEmpty by the identity of its two shapes and its operation
+ * (mixin.ShapesJoinMixin). Shapes are immutable, so the same objects always give the same answer;
+ * keys hold the shapes, which their block states hold anyway. Bounded: past MAX entries it starts
+ * over. HORIZON_SHAPE_MEMO=0 turns it off. (UMP, 2026-11-14)
+ */
+public final class HorizonShapeMemo {
+    private HorizonShapeMemo() {}
+
+    private static final boolean ON = !"0".equals(System.getenv("HORIZON_SHAPE_MEMO"));
+    private static final int MAX = 2_000_000;
+    private static final ConcurrentHashMap<Key, Boolean> MEMO = new ConcurrentHashMap<>();
+    private static final LongAdder HITS = new LongAdder();
+    private static final LongAdder MISSES = new LongAdder();
+
+    private record Key(VoxelShape first, VoxelShape second, BooleanOp op) {
+        @Override
+        public boolean equals(Object o) {
+            return o instanceof Key k && k.first == first && k.second == second && k.op == op;
+        }
+
+        @Override
+        public int hashCode() {
+            return (System.identityHashCode(first) * 31 + System.identityHashCode(second)) * 31 + System.identityHashCode(op);
+        }
+    }
+
+    public static Boolean get(VoxelShape first, VoxelShape second, BooleanOp op) {
+        if (!ON) return null;
+        Boolean known = MEMO.get(new Key(first, second, op));
+        if (known != null) HITS.increment();
+        else MISSES.increment();
+        return known;
+    }
+
+    public static void put(VoxelShape first, VoxelShape second, BooleanOp op, boolean value) {
+        if (!ON) return;
+        if (MEMO.size() >= MAX) MEMO.clear();
+        MEMO.put(new Key(first, second, op), value);
+    }
+
+    /** One line: how often the memory answered (called after the mods' entrypoints). */
+    public static void report() {
+        long hits = HITS.sum(), misses = MISSES.sum();
+        if (hits + misses > 0) {
+            Natives.log("Java mods: shape joins remembered " + hits + " of " + (hits + misses)
+                    + " times; " + MEMO.size() + " kept");
+        }
+    }
+}
diff --git a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/mixin/ShapesJoinMixin.java b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/mixin/ShapesJoinMixin.java
new file mode 100644
index 0000000000..4448b0af61
--- /dev/null
+++ b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/mixin/ShapesJoinMixin.java
@@ -0,0 +1,33 @@
+package dev.horizonlab.platform.mixin;
+
+import dev.horizonlab.platform.HorizonShapeMemo;
+import net.minecraft.world.phys.shapes.BooleanOp;
+import net.minecraft.world.phys.shapes.Shapes;
+import net.minecraft.world.phys.shapes.VoxelShape;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+/**
+ * Shapes.joinIsNotEmpty answered from memory for the same two shapes and operation. It is a pure
+ * function of immutable shapes, and block registration asks it for every state's faces and support
+ * types (BlockStateBase.Cache: 18 a state), with the same shape objects shared by many states: with
+ * 184 mods, 826,000 states, it was most of the mods' start (UMP startup samples).
+ * See {@link HorizonShapeMemo}. (UMP, 2026-11-14)
+ */
+@Mixin(Shapes.class)
+public abstract class ShapesJoinMixin {
+    @Inject(method = "joinIsNotEmpty(Lnet/minecraft/world/phys/shapes/VoxelShape;Lnet/minecraft/world/phys/shapes/VoxelShape;Lnet/minecraft/world/phys/shapes/BooleanOp;)Z",
+            at = @At("HEAD"), cancellable = true)
+    private static void horizon$remembered(VoxelShape first, VoxelShape second, BooleanOp op, CallbackInfoReturnable<Boolean> info) {
+        Boolean known = HorizonShapeMemo.get(first, second, op);
+        if (known != null) info.setReturnValue(known);
+    }
+
+    @Inject(method = "joinIsNotEmpty(Lnet/minecraft/world/phys/shapes/VoxelShape;Lnet/minecraft/world/phys/shapes/VoxelShape;Lnet/minecraft/world/phys/shapes/BooleanOp;)Z",
+            at = @At("RETURN"))
+    private static void horizon$remember(VoxelShape first, VoxelShape second, BooleanOp op, CallbackInfoReturnable<Boolean> info) {
+        HorizonShapeMemo.put(first, second, op, info.getReturnValueZ());
+    }
+}
