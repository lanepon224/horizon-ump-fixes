From 6e58667b1586d21397040d6183da52ae831a9721 Mon Sep 17 00:00:00 2001
From: UMP <ump@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH 44/90] java mods: a data load that fails names the mods whose
 start failed

A mod whose client start fails half way can leave the server data load failing with a message naming none of them (Paladin's Furniture beside The Graveyard: 'Unbound tags in registry entity_type', a conflict between the two that plain Minecraft has too). The failure now adds which mods' start failed, as the likely cause.

UMP: the 300-mod pack (346 jars, 488 Fabric mods) now joins a world; 75/75 tests.
---
 .../horizonlab/bridge/fabric/FabricBoot.java  | 19 ++++++++++++
 crates/horizon-jvm/src/lib.rs                 | 31 +++++++++++++++++--
 2 files changed, 48 insertions(+), 2 deletions(-)

diff --git a/crates/horizon-jvm/java/dev/horizonlab/bridge/fabric/FabricBoot.java b/crates/horizon-jvm/java/dev/horizonlab/bridge/fabric/FabricBoot.java
index c4b0c3548c..d182d5f2ed 100644
--- a/crates/horizon-jvm/java/dev/horizonlab/bridge/fabric/FabricBoot.java
+++ b/crates/horizon-jvm/java/dev/horizonlab/bridge/fabric/FabricBoot.java
@@ -124,6 +124,15 @@ public final class FabricBoot {
                     while (cause.getCause() != null && cause.getCause() != cause) cause = cause.getCause();
                     Natives.log("  and: " + other.getMessage() + ", caused by " + cause);
                 }
+                // Kept for the reason a later failure gives: a mod whose client start failed half way
+                // (registered part of its content) can make the data load fail with a message naming
+                // none of them (Paladin's Furniture beside The Graveyard: "Unbound tags"). (UMP, 2026-11-13)
+                java.util.List<String> ids = new java.util.ArrayList<>();
+                for (Throwable t : prepend(e, e.getSuppressed())) {
+                    var m = java.util.regex.Pattern.compile("provided by '([^']+)'").matcher(String.valueOf(t.getMessage()));
+                    if (m.find()) ids.add(m.group(1));
+                }
+                clientFailures = String.join(", ", ids);
             }
             try {
                 Class<?> client = Class.forName("dev.horizonlab.platform.HorizonClient", true, gameLoader);
@@ -202,6 +211,16 @@ public final class FabricBoot {
     }
 
     /** A game or mod class, loaded and initialized by Knot, so Mixins apply to it. */
+    /** The mods whose client entrypoint failed, for a later failure's message ("" when none). */
+    public static volatile String clientFailures = "";
+
+    private static Throwable[] prepend(Throwable first, Throwable[] rest) {
+        Throwable[] all = new Throwable[rest.length + 1];
+        all[0] = first;
+        System.arraycopy(rest, 0, all, 1, rest.length);
+        return all;
+    }
+
     public static Class<?> gameClass(String name) throws ClassNotFoundException {
         if (gameLoader == null) throw new IllegalStateException("Fabric Loader is not started");
         return Class.forName(name.replace('/', '.'), true, gameLoader);
diff --git a/crates/horizon-jvm/src/lib.rs b/crates/horizon-jvm/src/lib.rs
index 80516ac54a..b86ccbf414 100644
--- a/crates/horizon-jvm/src/lib.rs
+++ b/crates/horizon-jvm/src/lib.rs
@@ -411,8 +411,18 @@ pub fn start(config: &Config) -> Result<&'static Bridge, String> {
             let mods =
                 start_fabric(&mut env, fabric, &add_mods).map_err(|e| describe(&mut env, e))?;
             if platform {
-                prepare_data(&mut env, &config.work.join("datapacks"))
-                    .map_err(|e| describe(&mut env, e))?;
+                prepare_data(&mut env, &config.work.join("datapacks")).map_err(|e| {
+                    let why = describe(&mut env, e);
+                    // A mod whose client start failed half way can leave the data load failing
+                    // with a message that names none of them: name them as the likely cause.
+                    match client_failures(&mut env) {
+                        Some(mods) => format!(
+                            "{why}. These mods failed while starting, which can cause this \
+                             (try without them, or check they work together): {mods}"
+                        ),
+                        None => why,
+                    }
+                })?;
             }
             mods
         }
@@ -1000,6 +1010,23 @@ fn start_fabric(
     Ok(out)
 }
 
+/// The mods whose client start failed (`FabricBoot.clientFailures`), if any.
+fn client_failures(env: &mut JNIEnv) -> Option<String> {
+    let value = env
+        .get_static_field(
+            "dev/horizonlab/bridge/fabric/FabricBoot",
+            "clientFailures",
+            "Ljava/lang/String;",
+        )
+        .and_then(|v| v.l())
+        .ok()?;
+    if value.is_null() {
+        return None;
+    }
+    let text: String = env.get_string(&JString::from(value)).ok()?.into();
+    (!text.is_empty()).then_some(text)
+}
+
 /// Loads the server's data (vanilla's data pack and the mods'): `HorizonData.prepare`, in the
 /// platform mod, through Fabric's class loader.
 fn prepare_data(env: &mut JNIEnv, datapacks: &Path) -> jni::errors::Result<()> {
