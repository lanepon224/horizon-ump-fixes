From 572afcd086e8df67962ffd11db7ce762123d36d2 Mon Sep 17 00:00:00 2001
From: UMP <ump@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH 90/90] Java mods' content: remove the build's own inputs from
 the cache

Only the carried content folders are read back (content::cached). The oracle facts the build writes and reads once were 1.2 GB with 184 mods, and the files no mod could claim another 50 MB: both go once the build is done.

UMP 184 mods: java-content cache 2.2 -> 0.96 GB; the game loads all 188 content mods from it and joins a world.
---
 crates/horizon-jvm/src/content.rs | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/crates/horizon-jvm/src/content.rs b/crates/horizon-jvm/src/content.rs
index c4d1b9f772..ed515b773e 100644
--- a/crates/horizon-jvm/src/content.rs
+++ b/crates/horizon-jvm/src/content.rs
@@ -169,6 +169,12 @@ pub fn build(
         Err(e) => log(format!("Java mods' content: no block tints: {e}")),
     }
     let _ = std::fs::remove_dir_all(&instance);
+    // The build's own inputs: only the carried folders are read back (`cached`). The oracle
+    // facts were 1.2 GB with 184 mods, the files no mod could claim another 50 MB.
+    let _ = std::fs::remove_dir_all(work.join("oracle"));
+    for dir in std::fs::read_dir(work.join("mods")).into_iter().flatten().flatten() {
+        let _ = std::fs::remove_dir_all(dir.path().join("outside"));
+    }
     std::fs::write(cache.join("stamp"), stamp(jars)).map_err(|e| format!("stamp: {e}"))?;
     Ok(carried(&work))
 }
