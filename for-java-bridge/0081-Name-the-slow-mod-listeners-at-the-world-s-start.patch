From 8261226949bc7bbaa258af93a519c148e0c08f31 Mon Sep 17 00:00:00 2001
From: UMP <ump@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH 81/90] Name the slow mod listeners at the world's start

The world's start runs the mods' lifecycle listeners and client reload listeners one after another on the mirror's server thread; one taking 300 ms or more (200 ms for a reload listener) is now logged with its class, and the client reload logs its total. UMP 184 mods: JourneyMap's CLIENT_STARTED 2.0 s, Architectury's SERVER_STARTED 1.1 s, ComputerCraft 0.8 + 0.6 s, Plasmo Voice's slib 0.8 s; the client reload 0.6 s.
---
 .../platform/dev/horizonlab/platform/HorizonClient.java    | 7 ++++++-
 .../platform/dev/horizonlab/platform/HorizonServer.java    | 4 ++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonClient.java b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonClient.java
index a4a138a634..00db4cb2a9 100644
--- a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonClient.java
+++ b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonClient.java
@@ -2621,6 +2621,7 @@ public final class HorizonClient {
      */
     @SuppressWarnings("unchecked")
     private static void reloadClientResources() {
+        long reloadStarted = System.nanoTime();
         var type = net.minecraft.server.packs.PackType.CLIENT_RESOURCES;
         java.util.List<net.minecraft.server.packs.PackResources> packs = new java.util.ArrayList<>();
         try {
@@ -2702,8 +2703,11 @@ public final class HorizonClient {
                 continue;
             }
             try {
+                long began = System.nanoTime();
                 net.minecraft.server.packs.resources.SimpleReloadInstance.of(manager, java.util.List.of(listener), here, here,
                         java.util.concurrent.CompletableFuture.completedFuture(net.minecraft.util.Unit.INSTANCE)).done().join();
+                long took = (System.nanoTime() - began) / 1_000_000;
+                if (took >= 200) Natives.log("Horizon's client: a mod's resource reload took " + took + " ms: " + listener.getClass().getName());
                 ran++;
             } catch (Throwable t) {
                 Throwable root = t;
@@ -2722,7 +2726,8 @@ public final class HorizonClient {
                 }
             }
         }
-        Natives.log("Horizon's client: " + ran + " of the mods' resource reload listeners ran over " + packs.size()
+        Natives.log("Horizon's client: " + ran + " of the mods' resource reload listeners ran in "
+                + (System.nanoTime() - reloadStarted) / 1_000_000 + " ms over " + packs.size()
                 + " packs" + (skipped > 0 ? "; " + skipped + " that read baked models or textures run with the models" : ""));
     }
 
diff --git a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonServer.java b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonServer.java
index 31952bf16e..8253b32379 100644
--- a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonServer.java
+++ b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonServer.java
@@ -1533,7 +1533,11 @@ public final class HorizonServer {
             if (client && !HorizonDeviceMods.runs(handler.getClass())) continue;
             String name = handler.getClass().getName();
             int lambda = name.indexOf("$$");
+            long began = System.nanoTime();
             fire(event + " [" + (lambda > 0 ? name.substring(0, lambda) : name) + "]", () -> call.accept((T) handler));
+            // A slow one, named: the world's start runs these one after another on the server thread.
+            long took = (System.nanoTime() - began) / 1_000_000;
+            if (took >= 300) Natives.log("Java mods: " + event + " took " + took + " ms in " + (lambda > 0 ? name.substring(0, lambda) : name));
         }
     }
 
