From 4737dc55690cbe726ec45c9f9f9ddafdf0c26ca1 Mon Sep 17 00:00:00 2001
From: UMP <ump@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH 76/90] Equal boxes are one shape: Shapes.create shares
 instances

Mods build their shapes from new boxes on every call (Yuushya's collision files, Stoneworks, Macaw's calculateShapes), so the identity memos of joinIsNotEmpty and join saw new objects and kept answering nothing. Shapes.create (Shapes.box, Block.box/column) now returns the instance it made before for the same six coordinates; VoxelShape is immutable apart from its lazily filled face cache.

UMP 184 mods: 793k box creations shared (37.5k distinct); joins remembered 688k of 804k (was 479k); main entrypoints median 17.6 s (was ~20); ready/join medians 81/35 (noise).
---
 .../horizonlab/platform/HorizonShapeMemo.java | 19 ++++++++++++++++++-
 .../platform/mixin/ShapesJoinMixin.java       | 19 +++++++++++++++++++
 2 files changed, 37 insertions(+), 1 deletion(-)

diff --git a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonShapeMemo.java b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonShapeMemo.java
index e5ada98841..3471d01a53 100644
--- a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonShapeMemo.java
+++ b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/HorizonShapeMemo.java
@@ -20,6 +20,9 @@ public final class HorizonShapeMemo {
     private static final int MAX = 2_000_000;
     private static final ConcurrentHashMap<Key, Boolean> MEMO = new ConcurrentHashMap<>();
     private static final ConcurrentHashMap<Key, VoxelShape> JOINS = new ConcurrentHashMap<>();
+    private record Box(double x0, double y0, double z0, double x1, double y1, double z1) {}
+    private static final ConcurrentHashMap<Box, VoxelShape> BOXES = new ConcurrentHashMap<>();
+    private static final LongAdder BOX_HITS = new LongAdder();
     private static final LongAdder JOIN_HITS = new LongAdder();
     private static final LongAdder JOIN_MISSES = new LongAdder();
     private static final LongAdder HITS = new LongAdder();
@@ -65,13 +68,27 @@ public final class HorizonShapeMemo {
         JOINS.put(new Key(first, second, op), value);
     }
 
+    public static VoxelShape getBox(double x0, double y0, double z0, double x1, double y1, double z1) {
+        if (!ON) return null;
+        VoxelShape known = BOXES.get(new Box(x0, y0, z0, x1, y1, z1));
+        if (known != null) BOX_HITS.increment();
+        return known;
+    }
+
+    public static void putBox(double x0, double y0, double z0, double x1, double y1, double z1, VoxelShape value) {
+        if (!ON || value == null) return;
+        if (BOXES.size() >= MAX / 8) BOXES.clear();
+        BOXES.putIfAbsent(new Box(x0, y0, z0, x1, y1, z1), value);
+    }
+
     /** One line: how often the memory answered (called after the mods' entrypoints). */
     public static void report() {
         long hits = HITS.sum(), misses = MISSES.sum();
         if (hits + misses > 0) {
             Natives.log("Java mods: shape joins remembered " + hits + " of " + (hits + misses)
                     + " times; " + MEMO.size() + " kept; joined shapes " + JOIN_HITS.sum() + " of "
-                    + (JOIN_HITS.sum() + JOIN_MISSES.sum()) + "; " + JOINS.size() + " kept");
+                    + (JOIN_HITS.sum() + JOIN_MISSES.sum()) + "; " + JOINS.size() + " kept; boxes shared " + BOX_HITS.sum()
+                    + " times, " + BOXES.size() + " kept");
         }
     }
 }
diff --git a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/mixin/ShapesJoinMixin.java b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/mixin/ShapesJoinMixin.java
index 8b773d155d..5317dc8728 100644
--- a/crates/horizon-jvm/java/platform/dev/horizonlab/platform/mixin/ShapesJoinMixin.java
+++ b/crates/horizon-jvm/java/platform/dev/horizonlab/platform/mixin/ShapesJoinMixin.java
@@ -39,6 +39,25 @@ public abstract class ShapesJoinMixin {
         HorizonShapeMemo.putJoin(first, second, op, info.getReturnValue());
     }
 
+    /**
+     * Shapes.create (box, and every block's Block.box/column) gives the same instance for the same
+     * six coordinates: mods build their shapes from new boxes on every call (Yuushya's collision
+     * files, Stoneworks, Macaw's), so the joins above saw new objects each time and remembered
+     * nothing. Equal boxes are equal shapes; a shared one changes nothing a mod can see.
+     */
+    @Inject(method = "create(DDDDDD)Lnet/minecraft/world/phys/shapes/VoxelShape;", at = @At("HEAD"), cancellable = true)
+    private static void horizon$sharedBox(double x0, double y0, double z0, double x1, double y1, double z1,
+                                          CallbackInfoReturnable<VoxelShape> info) {
+        VoxelShape known = HorizonShapeMemo.getBox(x0, y0, z0, x1, y1, z1);
+        if (known != null) info.setReturnValue(known);
+    }
+
+    @Inject(method = "create(DDDDDD)Lnet/minecraft/world/phys/shapes/VoxelShape;", at = @At("RETURN"))
+    private static void horizon$keepBox(double x0, double y0, double z0, double x1, double y1, double z1,
+                                        CallbackInfoReturnable<VoxelShape> info) {
+        HorizonShapeMemo.putBox(x0, y0, z0, x1, y1, z1, info.getReturnValue());
+    }
+
     @Inject(method = "joinIsNotEmpty(Lnet/minecraft/world/phys/shapes/VoxelShape;Lnet/minecraft/world/phys/shapes/VoxelShape;Lnet/minecraft/world/phys/shapes/BooleanOp;)Z",
             at = @At("RETURN"))
     private static void horizon$remember(VoxelShape first, VoxelShape second, BooleanOp op, CallbackInfoReturnable<Boolean> info) {
