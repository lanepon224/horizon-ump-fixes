From 2e2f7ff53556aff1a1bb9b5014525dfdb57b45b1 Mon Sep 17 00:00:00 2001
From: UMP <ump@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH 39/90] A named world's preload reads the plain worldgen bundle
 too

Bone meal's and saplings' features (install_live_features) read the plain bundle as a world opens. The launch's preload read only the world's packs (with Java mods: their structures), so with a modded pack the plain bundle was read on the join: 8-11 s with 100 mods. It is read beside the preload now; live features are ready in 0.8 s. A worldgen load that differs from a cached one logs which bundles differ (WorldgenOverrides::differences).
---
 .../horizon-client/src/game/world_loading.rs  | 19 ++++++++++
 crates/horizon-client/src/vanillagen.rs       | 11 ++++++
 .../horizon-world/src/worldgen/overrides.rs   | 37 +++++++++++++++++++
 3 files changed, 67 insertions(+)

diff --git a/crates/horizon-client/src/game/world_loading.rs b/crates/horizon-client/src/game/world_loading.rs
index 721ed9a8f6..1b25a203b7 100644
--- a/crates/horizon-client/src/game/world_loading.rs
+++ b/crates/horizon-client/src/game/world_loading.rs
@@ -435,6 +435,22 @@ pub(super) fn preload_launch_world(
             // Not behind the server: the world's opening waits for it.
             let started = std::time::Instant::now();
             let sync = spawn_sync_preload(&resources, false);
+            // The plain bundle too, which bone meal's and saplings' features read
+            // (`install_live_features`) as the world opens: with a world's data packs (a big Java
+            // mod pack's structures) it isn't the same data, and was read then, 8-11 s of the
+            // join with 100 mods. (UMP, 2026-11-13)
+            let plain = {
+                let resources = resources.clone();
+                std::thread::Builder::new()
+                    .name("World data preload".into())
+                    .spawn(move || {
+                        let _ = horizon_client::vanillagen::shared_data(
+                            &resources.join("worldgen"),
+                            registry,
+                        );
+                    })
+                    .ok()
+            };
             // Errors are left for the world opening to report. The world's
             // flags from its level.dat: the feature packs a flag forces on.
             let enabled_features = horizon_client::save::Level::read(&world_root)
@@ -459,6 +475,9 @@ pub(super) fn preload_launch_world(
                 &horizon_world::loot::PackOverlay::NONE,
             );
             join_sync_preload(sync, &resources);
+            if let Some(plain) = plain {
+                let _ = plain.join();
+            }
             log::info!(
                 "Horizon: world data preloaded for the launch's world in {} ms",
                 started.elapsed().as_millis()
diff --git a/crates/horizon-client/src/vanillagen.rs b/crates/horizon-client/src/vanillagen.rs
index beef6b7097..6447c95ff6 100644
--- a/crates/horizon-client/src/vanillagen.rs
+++ b/crates/horizon-client/src/vanillagen.rs
@@ -722,6 +722,17 @@ pub fn shared_data_with(
     {
         return Ok(data.clone());
     }
+    // A load the cache held another set of packs for (the launch's preload): what differs,
+    // as the reason the world waits for this load.
+    if let Some((_, other, _)) = cache
+        .iter()
+        .find(|(path, o, _)| path == dir && !o.is_empty() && o != overrides)
+    {
+        log::info!(
+            "Horizon: worldgen data loaded again: the packs differ from the preloaded in {}",
+            overrides.differences(other).join(", ")
+        );
+    }
     let started = std::time::Instant::now();
     let data = GeneratorData::load_with(dir, registry, overrides)?;
     log::info!("Horizon: worldgen data loaded in {:?}", started.elapsed());
diff --git a/crates/horizon-world/src/worldgen/overrides.rs b/crates/horizon-world/src/worldgen/overrides.rs
index defb9cbc80..a74b29d3d0 100644
--- a/crates/horizon-world/src/worldgen/overrides.rs
+++ b/crates/horizon-world/src/worldgen/overrides.rs
@@ -159,6 +159,43 @@ impl WorldgenOverrides {
     pub fn is_empty(&self) -> bool {
         self.entries.is_empty() && self.tags.is_empty() && self.templates.is_empty()
     }
+    /// Where these differ from `other`, for the log: the bundles whose entries or tags differ
+    /// (with how many ids each side has) and whether the templates do.
+    pub fn differences(&self, other: &Self) -> Vec<String> {
+        let mut out = Vec::new();
+        let names: std::collections::BTreeSet<&String> =
+            self.entries.keys().chain(other.entries.keys()).collect();
+        for name in names {
+            let (a, b) = (self.entries.get(name), other.entries.get(name));
+            if a != b {
+                let ids = |m: Option<&BTreeMap<String, String>>| m.map_or(0, BTreeMap::len);
+                let only: Vec<&String> = a
+                    .into_iter()
+                    .flatten()
+                    .filter(|(k, _)| !b.is_some_and(|b| b.contains_key(*k)))
+                    .map(|(k, _)| k)
+                    .take(3)
+                    .collect();
+                out.push(format!("{name} ({} vs {}; e.g. {only:?})", ids(a), ids(b)));
+            }
+        }
+        let tags: std::collections::BTreeSet<&String> =
+            self.tags.keys().chain(other.tags.keys()).collect();
+        for name in tags {
+            let (a, b) = (self.tags.get(name), other.tags.get(name));
+            if a != b {
+                out.push(format!(
+                    "tags {name} ({} vs {})",
+                    a.map_or(0, Vec::len),
+                    b.map_or(0, Vec::len)
+                ));
+            }
+        }
+        if self.templates != other.templates {
+            out.push("templates".into());
+        }
+        out
+    }
     /// A pack's file for `id` in `bundle`: called for packs from the lowest
     /// to the highest, so the last call for an id wins.
     pub fn set(&mut self, bundle: &str, id: &str, json: String) {
