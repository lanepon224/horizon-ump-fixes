From 16464b3b01f7859e1f51bca67f8eb6e49705e0b9 Mon Sep 17 00:00:00 2001
From: UMP <ump@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH 61/90] Data packs of a prepared root listed and read from its
 data file

DataStore::load (functions, predicates, loot, recipes... for the server's data packs) walked the built-in pack's data folder kind by kind in every namespace, stat'ing every entry, and read each file from the disk: with a big pack's content root (hundreds of namespaces, ~200k files) that took tens of seconds of a world's open. A folder pack under a prepared root (the game's own or the mods' content root, horizon-data.bin) now lists and reads from that file, in the same walk order.

UMP, 184 mods, warm start on an SSD, 2 runs: ready 112/116 s, join 38/39 s (before 119-166 s, 43-84 s). datapack tests 11/11.
---
 crates/horizon-client-render/src/datapack.rs | 35 +++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/crates/horizon-client-render/src/datapack.rs b/crates/horizon-client-render/src/datapack.rs
index 58fccdf425..3bc9827022 100644
--- a/crates/horizon-client-render/src/datapack.rs
+++ b/crates/horizon-client-render/src/datapack.rs
@@ -49,6 +49,39 @@ impl DataPack {
         let Source::Dir(root) = &self.source else {
             return self.list("data/");
         };
+        // A prepared root (the game's own, or the mods' content root) lists its files from its
+        // data file: walking a big pack's content root folder by folder, 13 kinds in hundreds of
+        // namespaces, stat'ing every entry, took tens of seconds of a world's open. (UMP, 2026-11-14)
+        if let Some(files) = horizon_core::prepared_files::files_under(&root.join("data")) {
+            // `files_under` names them from `data/`: `<namespace>/<kind>/...`.
+            let mut out: Vec<String> = files
+                .into_iter()
+                .map(|f| format!("data/{f}"))
+                .filter(|f| {
+                    f.strip_prefix("data/")
+                        .and_then(|r| r.split_once('/'))
+                        .is_some_and(|(_, r)| {
+                            kinds.iter().any(|k| {
+                                r.strip_prefix(k).is_some_and(|r| r.starts_with('/'))
+                            })
+                        })
+                })
+                .collect();
+            // In walk order: namespace, then kind, then path.
+            out.sort_by(|a, b| {
+                let key = |f: &str| {
+                    let r = f.strip_prefix("data/").unwrap_or(f);
+                    let (ns, rest) = r.split_once('/').unwrap_or((r, ""));
+                    let k = kinds
+                        .iter()
+                        .position(|k| rest.strip_prefix(k).is_some_and(|r| r.starts_with('/')))
+                        .unwrap_or(usize::MAX);
+                    (ns.to_owned(), k, rest.to_owned())
+                };
+                key(a).cmp(&key(b))
+            });
+            return out;
+        }
         let Ok(entries) = std::fs::read_dir(root.join("data")) else {
             return Vec::new();
         };
@@ -83,7 +116,7 @@ impl DataPack {
     pub fn read(&self, path: &str) -> Option<Vec<u8>> {
         let mut bytes = match &self.source {
             Source::Zip(z) => z.read(path).ok(),
-            Source::Dir(root) => std::fs::read(root.join(path)).ok(),
+            Source::Dir(root) => horizon_core::prepared_files::read(&root.join(path)).ok(),
         }?;
         // A JSON file without its leading byte-order mark: Minecraft's reader skips one (mods ship
         // files saved with it: 395 in UMP's 300-mod pack, Lio's Overhauled Villages' worldgen
