+                    }
+                    Ok::<(), std::io::Error>(())
+                })
+            })
+            .collect();
+        for job in jobs {
+            job.join()
+                .map_err(|_| std::io::Error::other("linking the overlay's files panicked"))??;
         }
         Ok(())
-    } else {
