-        fs::create_dir_all(at)?;
-        for entry in fs::read_dir(target)?.flatten() {
-            link(&entry.path(), &at.join(entry.file_name()))?;
+    if !target.is_dir() {
+        return link_file(target, at, |target, at| fs::hard_link(target, at));
