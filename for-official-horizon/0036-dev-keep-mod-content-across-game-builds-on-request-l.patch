From 699c6778a6e140c0da118ca6b2cdccb9c41f26d2 Mon Sep 17 00:00:00 2001
From: UMP <ump@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH 36/90] dev: keep mod content across game builds on request;
 lod-ground reports the far biome

HORIZON_CONTENT_KEEP_ACROSS_BUILDS leaves the game's exe out of the mod-content stamp, so a developer's test folder keeps 100 mods' built content (10-30 minutes to build) across rebuilds of the game. Players never set it. horizon-ctl lod-ground also tells the far column's biome.
---
 crates/horizon-client-render/src/lod.rs   | 15 +++++++++++++++
 crates/horizon-client/src/game/control.rs |  6 ++++++
 crates/horizon-client/src/mod_content.rs  |  7 ++++++-
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/crates/horizon-client-render/src/lod.rs b/crates/horizon-client-render/src/lod.rs
index fd6bccd631..0650c09c18 100644
--- a/crates/horizon-client-render/src/lod.rs
+++ b/crates/horizon-client-render/src/lod.rs
@@ -1681,6 +1681,21 @@ impl Lod {
     /// its block, from the finest tile sampled there. For aiming past the
     /// resident chunks (`game.raycast`); water is passed, as the view's ray
     /// passes it.
+    /// The far column's biome at block column (x, z), from the finest tile sampled there.
+    pub fn ground_biome(&self, x: i32, z: i32) -> Option<u16> {
+        (0..=MAX_LEVEL).find_map(|level| {
+            let size = 16 << level;
+            let key = TileKey {
+                x: x.div_euclid(size),
+                z: z.div_euclid(size),
+                level,
+            };
+            let columns = self.ready.get(&key).filter(|c| c.len() == CELLS * CELLS)?;
+            let cell = size / CELLS as i32;
+            let (cx, cz) = ((x - key.x * size) / cell, (z - key.z * size) / cell);
+            Some(columns[cz as usize * CELLS + cx as usize].surface?.biome)
+        })
+    }
     pub fn ground(&self, x: i32, z: i32) -> Option<(i32, BlockStateId)> {
         (0..=MAX_LEVEL).find_map(|level| {
             let size = 16 << level;
diff --git a/crates/horizon-client/src/game/control.rs b/crates/horizon-client/src/game/control.rs
index 848201c41f..2dbe41ca21 100644
--- a/crates/horizon-client/src/game/control.rs
+++ b/crates/horizon-client/src/game/control.rs
@@ -881,11 +881,17 @@ impl Game<'_> {
                 let x: i32 = arg(1)?.parse()?;
                 let z: i32 = arg(2)?.parse()?;
                 let found = self.lod.as_ref().and_then(|lod| lod.ground(x, z));
+                let biome = self
+                    .lod
+                    .as_ref()
+                    .and_then(|lod| lod.ground_biome(x, z))
+                    .map(|id| self.res.biomes().get(id).name.to_string());
                 Ok(Some(match found {
                     Some((height, state)) => json!({
                         "ok": true,
                         "height": height,
                         "block": self.res.facts().get(state).name.to_string(),
+                        "biome": biome,
                     }),
                     None => json!({"ok": true, "height": null}),
                 }))
diff --git a/crates/horizon-client/src/mod_content.rs b/crates/horizon-client/src/mod_content.rs
index 76a66c82ee..68a9b49eb7 100644
--- a/crates/horizon-client/src/mod_content.rs
+++ b/crates/horizon-client/src/mod_content.rs
@@ -2858,7 +2858,12 @@ fn stamp(base: &Path, mods: &[ContentMod]) -> Result<String> {
         ))
     };
     let mut parts = vec!["horizon mod content 1".to_owned()];
-    parts.push(meta(&std::env::current_exe()?)?);
+    // A developer's test folder kept across rebuilds (UMP's perf folders) may keep its built
+    // content when the game's code that builds it hasn't changed: rebuilding 100 mods' content
+    // after every build of the game took 10-30 minutes. Players never rebuild the game.
+    if std::env::var_os("HORIZON_CONTENT_KEEP_ACROSS_BUILDS").is_none() {
+        parts.push(meta(&std::env::current_exe()?)?);
+    }
     let base = std::path::absolute(base)?;
     parts.push(
         String::from_utf8_lossy(&fs::read(base.join("horizon-resources.json"))?).into_owned(),
