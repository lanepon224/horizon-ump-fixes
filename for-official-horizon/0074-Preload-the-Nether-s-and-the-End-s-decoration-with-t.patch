From 64fba4aed1971179702eb9696dd6a8b8883c4dd0 Mon Sep 17 00:00:00 2001
From: UMP <ump@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH 74/90] Preload the Nether's and the End's decoration with the
 launch's world data

A data pack's function run in another dimension (execute in) opens that level on the server thread, which built its feature decoration there: ~2-3 s of a 184-mod join (UMP join samples: enter_command_level -> make_streaming -> Decoration::new_with). The launch preload now prepares the Nether's and the End's decoration on threads of their own beside the Overworld's.

UMP 184 mods, 5-run medians: ready 85 -> 83 s, join 37 -> 36 s; start hooks -> own player 9 -> 6-7 s.
---
 crates/horizon-client/src/game/world_loading.rs | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/crates/horizon-client/src/game/world_loading.rs b/crates/horizon-client/src/game/world_loading.rs
index 1b25a203b7..4a5ed0091f 100644
--- a/crates/horizon-client/src/game/world_loading.rs
+++ b/crates/horizon-client/src/game/world_loading.rs
@@ -465,6 +465,20 @@ pub(super) fn preload_launch_world(
             ) {
                 let preset = horizon_client::save::WorldGen::preset(&world_root);
                 let _ = data.prepare_decoration(preset, "minecraft:overworld");
+                // The Nether's and the End's too, on threads of their own: a data pack's
+                // function run in another dimension (`execute in`) opens that level on the
+                // server thread, which built its decoration there (~2-3 s of a 184-mod join,
+                // UMP join samples: enter_command_level -> make_streaming ->
+                // Decoration::new_with). (UMP, 2026-11-14)
+                for dimension in ["minecraft:the_nether", "minecraft:the_end"] {
+                    let data = data.clone();
+                    let preset = preset.to_owned();
+                    let _ = std::thread::Builder::new()
+                        .name("World data preload".into())
+                        .spawn(move || {
+                            let _ = data.prepare_decoration(&preset, dimension);
+                        });
+                }
             }
             // As in `preload_world_data`: the loot data and the server's
             // data share one read of the recipe folder.
