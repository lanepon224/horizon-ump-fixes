From 0824ef74c18de20e42649e1ee54dbc1f87030c49 Mon Sep 17 00:00:00 2001
From: UMP <ump@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH 56/90] Faster starts with big mod packs: loot tables, recipes
 and Fusion textures read namespace by namespace at once

Loot tables (load_kind and the cache key's file walk), the content mods' recipe folders (Recipes::sources) and Fusion's .mcmeta scan read each of a modded pack's hundreds of namespaces in turn; now all at once, merged in the same order. Items::load logs how long its parts take (defaults, items, loot, tags, enchantments).

UMP, 184 mods, warm start on an SSD: loot 36-45 -> 0-18 s, ready 280 -> 241 s.
---
 crates/horizon-client-render/src/fusion.rs | 29 ++++++++-----
 crates/horizon-client/src/crafting.rs      | 39 ++++++++++++++++--
 crates/horizon-items/src/items.rs          | 25 +++++++++--
 crates/horizon-world/src/loot.rs           | 48 +++++++++++++++++++---
 4 files changed, 118 insertions(+), 23 deletions(-)

diff --git a/crates/horizon-client-render/src/fusion.rs b/crates/horizon-client-render/src/fusion.rs
index 99b55c3ece..8dd8f06291 100644
--- a/crates/horizon-client-render/src/fusion.rs
+++ b/crates/horizon-client-render/src/fusion.rs
@@ -174,19 +174,28 @@ fn connecting_textures(root: &Path) -> HashMap<String, Meta> {
     let Ok(namespaces) = fs::read_dir(root.join("assets")) else {
         return out;
     };
-    for ns in namespaces.flatten() {
-        let ns_name = ns.file_name().to_string_lossy().into_owned();
-        let textures = ns.path().join("textures");
-        for path in mcmeta_files(&textures) {
+    // Every namespace's .mcmeta files listed and read at once: a modded pack's hundreds of
+    // namespaces and tens of thousands of files, walked one at a time, took up to a minute of a
+    // start. Only the files naming Fusion are kept. (UMP, 2026-11-14)
+    let namespaces: Vec<_> = namespaces.flatten().collect();
+    let found: Vec<Vec<(String, PathBuf, PathBuf, String)>> =
+        crate::par::par_map(&namespaces, |ns| {
+            let ns_name = ns.file_name().to_string_lossy().into_owned();
+            let textures = ns.path().join("textures");
+            mcmeta_files(&textures)
+                .into_iter()
+                .filter_map(|path| {
+                    let text = horizon_core::prepared_files::read_to_string(&path).ok()?;
+                    text.contains("fusion")
+                        .then(|| (ns_name.clone(), textures.clone(), path, text))
+                })
+                .collect()
+        });
+    for (ns_name, textures, path, text) in found.into_iter().flatten() {
+        {
             let Some(png) = path.to_str().and_then(|p| p.strip_suffix(".png.mcmeta")) else {
                 continue;
             };
-            let Ok(text) = horizon_core::prepared_files::read_to_string(&path) else {
-                continue;
-            };
-            if !text.contains("fusion") {
-                continue;
-            }
             let Some(rel) = Path::new(png)
                 .strip_prefix(&textures)
                 .ok()
diff --git a/crates/horizon-client/src/crafting.rs b/crates/horizon-client/src/crafting.rs
index a4a6104011..65a2a6b243 100644
--- a/crates/horizon-client/src/crafting.rs
+++ b/crates/horizon-client/src/crafting.rs
@@ -1467,10 +1467,41 @@ impl Recipes {
         for file in &crate::json_folder::read(&root.join("data/minecraft/recipe"))?.files {
             sources.push((file.name.clone(), file.bytes()?.to_vec()));
         }
-        for namespace in crate::mod_content::namespaces(root) {
-            let dir = root.join(format!("data/{namespace}/recipe"));
-            if dir.is_dir() {
-                for file in &crate::json_folder::read(&dir)?.files {
+        // Every namespace's folder read at once: hundreds with mods, each in turn took tens of
+        // seconds of a start. Added in the same order. (UMP, 2026-11-14)
+        let namespaces: Vec<String> = crate::mod_content::namespaces(root).into_iter().collect();
+        let next = std::sync::atomic::AtomicUsize::new(0);
+        let slots: Vec<std::sync::Mutex<Option<std::io::Result<Option<std::sync::Arc<crate::json_folder::Folder>>>>>> =
+            namespaces.iter().map(|_| std::sync::Mutex::new(None)).collect();
+        let threads = std::thread::available_parallelism().map_or(4, |n| n.get()).clamp(1, 12);
+        std::thread::scope(|scope| {
+            for _ in 0..threads {
+                scope.spawn(|| loop {
+                    let i = next.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                    let Some(namespace) = namespaces.get(i) else {
+                        return;
+                    };
+                    let dir = root.join(format!("data/{namespace}/recipe"));
+                    let read = if dir.is_dir() {
+                        crate::json_folder::read(&dir).map(Some)
+                    } else {
+                        Ok(None)
+                    };
+                    *slots[i].lock().unwrap_or_else(std::sync::PoisonError::into_inner) = Some(read);
+                });
+            }
+        });
+        let folders: Vec<std::io::Result<Option<std::sync::Arc<crate::json_folder::Folder>>>> = slots
+            .into_iter()
+            .map(|s| {
+                s.into_inner()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                    .unwrap_or(Ok(None))
+            })
+            .collect();
+        for (namespace, folder) in namespaces.iter().zip(folders) {
+            if let Some(folder) = folder? {
+                for file in &folder.files {
                     sources.push((format!("{namespace}:{}", file.name), file.bytes()?.to_vec()));
                 }
             }
