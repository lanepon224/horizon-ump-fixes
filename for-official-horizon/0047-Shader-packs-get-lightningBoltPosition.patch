From d244b8aaa351a1f6c38447c1d9cd2f99948ddfa2 Mon Sep 17 00:00:00 2001
From: UMP <ump@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH 47/90] Shader packs get lightningBoltPosition

Iris gives packs the newest lightning bolt's position from the camera (w 1 while one is there, all 0 without); 5 of the 8 most-downloaded packs read it for their lightning flash and lit it from 0 here. FrameUniforms gives it from the frame's bolts, and custom uniforms see it.

UMP shader load test: all 8 packs start and draw (ump/poc/shaders/SHADERS.md); 75/75 tests.
---
 .../horizon-client-render/src/gfx/pack_uniforms.rs | 13 ++++++++++++-
 crates/horizon-shaders/src/custom.rs               | 14 +++++++-------
 2 files changed, 19 insertions(+), 8 deletions(-)

diff --git a/crates/horizon-client-render/src/gfx/pack_uniforms.rs b/crates/horizon-client-render/src/gfx/pack_uniforms.rs
index a19e1cf6e5..6eeedaf4dc 100644
--- a/crates/horizon-client-render/src/gfx/pack_uniforms.rs
+++ b/crates/horizon-client-render/src/gfx/pack_uniforms.rs
@@ -309,6 +309,7 @@ pub const NAMES: &[&str] = &[
     "cloudTime",
     "isElytraFlying",
     "cloudHeight",
+    "lightningBoltPosition",
 ];
 
 /// What programs that draw the game's geometry (gbuffers, shadow) read as `fogMode`,
@@ -691,6 +692,15 @@ impl FrameUniforms {
                 "upPosition" => v3(to_view(Vec3::new(0.0, 100.0, 0.0))),
                 "sunPosition" => v3(sun),
                 "endFlashPosition" => v3(to_view(inputs.end_flash_direction)),
+                // Iris: the newest lightning bolt's position from the camera, w 1 while one is
+                // there, all 0 without (5 of the 8 most-downloaded packs flash their sky by it).
+                "lightningBoltPosition" => Value::f(&match frame.lightning.bolts.last() {
+                    Some(b) => {
+                        let at = (glam::DVec3::from(b.at) - frame.camera).as_vec3();
+                        [at.x, at.y, at.z, 1.0]
+                    }
+                    None => [0.0; 4],
+                }),
                 "centerDepthSmooth" => Value::f(&[center_depth]),
                 "moonPosition" => v3(moon),
                 "shadowLightPosition" => v3(if day { sun } else { moon }),
@@ -887,6 +897,7 @@ fn components(name: &str) -> usize {
         | "fogColor"
         | "skyColor"
         | "endFlashPosition" => 3,
+        "lightningBoltPosition" => 4,
         "eyeBrightness" | "eyeBrightnessSmooth" | "atlasSize" => 2,
         "entityColor" => 4,
         n if n.starts_with("gbuffer") || n.starts_with("shadow") && n != "shadowAngle" => 16,
@@ -1031,7 +1042,7 @@ mod tests {
 
     #[test]
     fn elytra_and_cloud_height_uniforms_are_written() {
-        assert!(NAMES.ends_with(&["isElytraFlying", "cloudHeight"]));
+        assert!(NAMES.ends_with(&["isElytraFlying", "cloudHeight", "lightningBoltPosition"]));
         let mut out = vec![0u8; 16];
         Value::i(&[1]).write("bool", &mut out, 0);
         assert_eq!(i32::from_ne_bytes(out[0..4].try_into().unwrap()), 1);
diff --git a/crates/horizon-shaders/src/custom.rs b/crates/horizon-shaders/src/custom.rs
index ea815f555f..1a5ab66130 100644
--- a/crates/horizon-shaders/src/custom.rs
+++ b/crates/horizon-shaders/src/custom.rs
@@ -103,7 +103,7 @@ const HIDDEN: [&str; 13] = [
 
 /// Names Iris 1.11.7's custom uniforms see (our probe of #8995) that the game doesn't give yet:
 /// such a name alone reads 0, and the expression keeps the rest.
-const NOT_GIVEN_YET: [&str; 2] = ["currentRenderedItemId", "lightningBoltPosition"];
+const NOT_GIVEN_YET: [&str; 1] = ["currentRenderedItemId"];
 
 /// The `int` built-ins of Iris 1.11.7's custom uniforms (an int vector for `eyeBrightness`,
 /// `eyeBrightnessSmooth` and the `...PositionInt`s). Our probe packs of #9126 wrote each name
@@ -1328,10 +1328,10 @@ mod tests {
              uniform.vec3.w = vec3(skyColor.r, entityColor.a, blockEntityId) * 0.0 + 2.0\n\
              uniform.float.r = currentRenderedItemId * 0.0 + lightningBoltPosition.x + 2.0\n",
         );
-        // The game gives every name here but `notAName`, `currentRenderedItemId` and
-        // `lightningBoltPosition`, as Horizon's frame uniforms do.
+        // The game gives every name here but `notAName` and `currentRenderedItemId`, as
+        // Horizon's frame uniforms do (`lightningBoltPosition` given, its x 1).
         let builtin = |n: &str| match n {
-            "notAName" | "currentRenderedItemId" | "lightningBoltPosition" => None,
+            "notAName" | "currentRenderedItemId" => None,
             "fogColor" | "skyColor" => Some(Val::vector(&[0.5, 0.6, 0.7])),
             "entityColor" => Some(Val::vector(&[0.0; 4])),
             _ => Some(Val::scalar(1.0)),
@@ -1340,13 +1340,13 @@ mod tests {
         // `w` reads 0 as well: `vec3 * 0.0` joins a vector and a scalar (#9086).
         assert_eq!(
             x,
-            [2.0, 0.0, 0.0, 0.0, 0.0, 3.0, 0.0, 0.0, 6.0, 2.0, 0.0, 2.0]
+            [2.0, 0.0, 0.0, 0.0, 0.0, 3.0, 0.0, 0.0, 6.0, 2.0, 0.0, 3.0]
         );
-        assert_eq!(c.notes.len(), 10, "{:?}", c.notes);
+        assert_eq!(c.notes.len(), 9, "{:?}", c.notes);
         // The same on later frames, with no new notes.
         let again: Vec<f64> = c.eval(0.016, &builtin).iter().map(|v| v.v[0]).collect();
         assert_eq!(again, x);
-        assert_eq!(c.notes.len(), 10, "{:?}", c.notes);
+        assert_eq!(c.notes.len(), 9, "{:?}", c.notes);
     }
 
     /// Iris 1.11.7, with our probe packs of #9086 (`final` drew each uniform, a vector's `.y`):
