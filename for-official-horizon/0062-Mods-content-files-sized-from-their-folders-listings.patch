From: UMP <ump@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH 62/90] Mods' content files sized from their folders' listings,
 not a stat each

Content::read_declaring's walk and the content root's stamp stat'ed every file of every content mod (200k with a big pack): the walk uses the directory entry's metadata, the stamp the sizes and times listed with each folder (listed_meta), the same text per file.

UMP, 184 mods, warm start: content.resource_root 16 -> 7 s, content.read_mods 19 -> 3-16 s; mod_content 42/42, horizon-mods 38/38.
---
 crates/horizon-client/src/mod_content.rs | 42 +++++++++++++++++++++++-
 crates/horizon-mods/src/content.rs       |  5 ++-
 2 files changed, 45 insertions(+), 2 deletions(-)

diff --git a/crates/horizon-client/src/mod_content.rs b/crates/horizon-client/src/mod_content.rs
index 5267d18407..6ea5279d56 100644
--- a/crates/horizon-client/src/mod_content.rs
+++ b/crates/horizon-client/src/mod_content.rs
@@ -2985,6 +2985,36 @@ const STAMP: &str = "horizon-mod-content.stamp";
 /// [`STAMP`]'s name: whether a content root was built before.
 pub const STAMP_FILE: &str = STAMP;
 
+/// Every file under `dir` (its `assets` and `data`) with its size and modification time (ns
+/// since the epoch), from the folders' listings.
+fn listed_meta(dir: &Path) -> std::collections::HashMap<String, (u64, u128)> {
+    fn walk(dir: &Path, rel: &str, out: &mut std::collections::HashMap<String, (u64, u128)>) {
+        let Ok(read) = fs::read_dir(dir) else { return };
+        for entry in read.flatten() {
+            let Ok(m) = entry.metadata() else { continue };
+            let Some(name) = entry.file_name().to_str().map(|n| format!("{rel}/{n}")) else {
+                continue;
+            };
+            if m.is_dir() {
+                walk(&entry.path(), &name, out);
+            } else if m.is_file() {
+                let modified = m
+                    .modified()
+                    .ok()
+                    .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
+                    .unwrap_or_default()
+                    .as_nanos();
+                out.insert(name, (m.len(), modified));
+            }
+        }
+    }
+    let mut out = std::collections::HashMap::new();
+    for top in ["assets", "data"] {
+        walk(&dir.join(top), top, &mut out);
+    }
+    out
+}
+
